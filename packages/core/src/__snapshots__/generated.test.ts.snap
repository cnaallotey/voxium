exports[`the generated files > are the same every time > .cursor/rules/voxium.mdc 1`] = `
"---
description: Architecture rules of this repository, enforced by Voxium
alwaysApply: true
---
<!-- voxium:start -->
## Architecture rules (managed by Voxium)

This project has an enforced architecture. Pull requests that break it fail the Voxium check. Read this before adding imports or new files.

### Layers, top to bottom
A module may import from itself or from any module listed below it. Never import upward.

1. \`ui\` (src/ui/**)
2. \`services\` (src/services/**)
3. \`data\` (src/data/**)

### Rules
* L1 [block]: d Why: r
* C1 [block]: d Why: r

### How to work within this
* Before importing across modules, check the layer order above. If the import points upward, move the shared code down or pass it in as a parameter.
* If the Voxium MCP server is available, use it: \`get_rules_for_path\` before editing a file, \`check_import\` before adding a cross module import, and \`check_change\` with your planned file contents before you finish.
* To suggest an architecture change, call \`propose_architecture_change\` on that server. You can suggest, you cannot approve.
* Do not edit anything in the \`voxium/\` folder or this block. Architecture changes need approval from a Team Leader. If you think the architecture should change, say so in your PR description and explain why.
* Run \`npx --yes voxium@1.2.3 check\` before finishing. Fix every blocking violation.
<!-- voxium:end -->
"
`;

exports[`the generated files > are the same every time > voxium/CODEOWNERS.suggested 1`] = `
"# Architecture changes need a Team Leader. Add this to .github/CODEOWNERS
# and require code owner review in branch protection.
/voxium/ @acme/architects @lead @Owner-1
/CLAUDE.md @acme/architects @lead @Owner-1
/AGENTS.md @acme/architects @lead @Owner-1
/.cursor/rules/voxium.mdc @acme/architects @lead @Owner-1
# A pull request can edit the workflows that check it, and these owners, so both need review too.
/.github/ @acme/architects @lead @Owner-1
"
`;

exports[`the generated files > are the same every time > voxium/dependency-cruiser.json 1`] = `
"{
  "forbidden": [
    {
      "name": "voxium-1",
      "severity": "error",
      "comment": "Voxium rule L1: services must not import ui, which is above it. voxium check stays authoritative: it also follows imports through files outside every module, and knows the baseline and exceptions.",
      "from": {
        "path": "^(?:src/services/.*)$",
        "pathNot": "^(?:src/ui/.*)$"
      },
      "to": {
        "path": "^(?:src/ui/.*)$"
      }
    },
    {
      "name": "voxium-2",
      "severity": "error",
      "comment": "Voxium rule L1: data must not import ui, which is above it. voxium check stays authoritative: it also follows imports through files outside every module, and knows the baseline and exceptions.",
      "from": {
        "path": "^(?:src/data/.*)$",
        "pathNot": "^(?:src/ui/.*|src/services/.*)$"
      },
      "to": {
        "path": "^(?:src/ui/.*)$"
      }
    },
    {
      "name": "voxium-3",
      "severity": "error",
      "comment": "Voxium rule L1: data must not import services, which is above it. voxium check stays authoritative: it also follows imports through files outside every module, and knows the baseline and exceptions.",
      "from": {
        "path": "^(?:src/data/.*)$",
        "pathNot": "^(?:src/ui/.*|src/services/.*)$"
      },
      "to": {
        "path": "^(?:src/services/.*)$",
        "pathNot": "^(?:src/ui/.*)$"
      }
    },
    {
      "name": "voxium-4",
      "severity": "error",
      "comment": "Voxium rule C1: no circular imports. Voxium only forbids cycles between modules, so this is stricter. voxium check stays authoritative: it also follows imports through files outside every module, and knows the baseline and exceptions.",
      "from": {},
      "to": {
        "circular": true
      }
    }
  ],
  "options": {
    "doNotFollow": {
      "path": "node_modules"
    }
  }
}
"
`;

exports[`the generated files > are the same every time > voxium/gitlab-ci.yml 1`] = `
"# Generated by Voxium. Include it from .gitlab-ci.yml:
#
#   include:
#     - local: voxium/gitlab-ci.yml
#
# Then require pipelines to succeed before merging, and have a Team Leader own this file.
voxium-architecture:
  image: node:22
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  variables:
    GIT_DEPTH: "0"
  script:
    # The rules come from the default branch, by its full ref, so a merge request cannot pass by editing its own rules.
    - git -c core.hooksPath=/dev/null -c core.fsmonitor=false fetch --no-tags origin "+refs/heads/$CI_DEFAULT_BRANCH:refs/remotes/origin/$CI_DEFAULT_BRANCH"
    # Running from an empty folder keeps npx from picking up a "voxium" or an .npmrc the merge request ships itself.
    - cd "$(mktemp -d)"
    - npx --yes voxium@1.2.3 check --root "$CI_PROJECT_DIR" --rules-from "refs/remotes/origin/$CI_DEFAULT_BRANCH"
"
`;

exports[`the generated files > are the same every time > voxium/hooks/pre-commit 1`] = `
"#!/bin/sh
# Generated by Voxium. Checks what is staged, by the rules and baseline of the last commit.
# To use it: cp voxium/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Copy it rather than pointing core.hooksPath here, so that a pull request that edits it runs nothing on your machine.
set -eu
repo=$(git rev-parse --show-toplevel)
# From an empty folder, so that npx cannot pick up a "voxium" or an .npmrc the repository ships itself.
dir=$(mktemp -d)
trap 'rmdir "$dir"' EXIT
cd "$dir"
npx --yes voxium@1.2.3 check --staged --root "$repo"
"
`;
