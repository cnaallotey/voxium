{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voxium-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Old versions must not stay reachable on their own addresses.
  "preview_urls": false,
  // Needs the Workers Paid plan. A check takes longer than the 10 ms the free plan allows.
  "limits": { "cpu_ms": 30000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voxium",
      // From "wrangler d1 create voxium". Use your own when you deploy to another account.
      "database_id": "4c1869f3-d29d-4d67-bf50-b8ebb3121e41",
      // Local development keeps its own database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:3000",
    "GITHUB_APP_ID": "",
    "GITHUB_APP_SLUG": "voxium",
    "GITHUB_CLIENT_ID": "",
    // Exact published CLI version for setup pull requests, such as "voxium@1.2.3". Leave empty until it is on npm.
    "VOXIUM_CLI_PACKAGE": ""
  }
  // Secrets, set with "wrangler secret put":
  //   GITHUB_APP_PRIVATE_KEY, GITHUB_CLIENT_SECRET, GITHUB_WEBHOOK_SECRET, SESSION_SECRET
}
