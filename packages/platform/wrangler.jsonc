{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voxium-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voxium",
      // All zeros works for local dev. Replace with the id from "wrangler d1 create voxium" before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:3000",
    "GITHUB_APP_ID": "",
    "GITHUB_APP_SLUG": "voxium",
    "GITHUB_CLIENT_ID": ""
  }
  // Secrets, set with "wrangler secret put":
  //   GITHUB_APP_PRIVATE_KEY, GITHUB_CLIENT_SECRET, GITHUB_WEBHOOK_SECRET, SESSION_SECRET
}
