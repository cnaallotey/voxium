{
  "name": "Voxium",
  "url": "{{APP_URL}}",
  "description": "Keeps developers and coding agents inside your architecture.",
  "public": false,
  "hook_attributes": { "url": "{{WEBHOOK_URL}}/api/github/webhook", "active": true },
  "redirect_url": "{{APP_URL}}/setup/github-app",
  "callback_urls": ["{{APP_URL}}/api/auth/callback"],
  "setup_url": "{{APP_URL}}/api/auth/login",
  "default_permissions": {
    "metadata": "read",
    "contents": "write",
    "pull_requests": "write",
    "statuses": "write",
    "workflows": "write",
    "members": "read"
  },
  "default_events": ["pull_request", "pull_request_review"]
}
