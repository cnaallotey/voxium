{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "platform",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "cf:preview", "-w", "@voxium/platform", "--", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "platform-no-build",
      "runtimeExecutable": "npm",
